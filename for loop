import java.util.Scanner;
public class Main{
    public static void main (String[] args) {
        Scanner hp= new Scanner(System.in);
        int n =hp.nextInt();
        for(int i=1;i<=n;i++){
            for(int j=1;j<=n;j++){
                System.out.print("");
                for (int k=1;k<=i-j;k++ ) {
                    System.out.print(k);
                }
            }
            System.out.println();
        }
    }
}
