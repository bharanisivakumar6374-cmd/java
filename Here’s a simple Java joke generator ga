import java.util.Random;
import java.util.Scanner;

public class JokeGame {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        Random random = new Random();

        String[] jokes = {
            "Why did the computer go to the doctor? Because it had a virus!",
            "Why was the Java developer wearing glasses? Because he couldn't C#!",
            "Why do programmers prefer dark mode? Because light attracts bugs!",
            "Why did the student bring a ladder to class? Because he wanted to go to higher education!",
            "Why was the computer cold? Because it left its Windows open!"
        };

        System.out.println("😂 Welcome to the Java Joke Game!");
        System.out.println("Press 1 to get a joke");
        System.out.println("Press 0 to exit");

        while (true) {
            System.out.print("\nEnter your choice: ");
            int choice = sc.nextInt();

            if (choice == 1) {
                int index = random.nextInt(jokes.length);
                System.out.println("🤣 Joke: " + jokes[index]);
            } 
            else if (choice == 0) {
                System.out.println("Thanks for playing! 😄");
                break;
            } 
            else {
                System.out.println("Invalid choice! Try again.");
            }
        }

        sc.close();
    }
}
