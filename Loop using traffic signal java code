public class Main {
    public static void main(String[] args) {

        String[] signal = {"🔴 Red", "🟡 Yellow", "🟢 Green"};

        for (int i = 0; i < signal.length; i++) {
            System.out.println(signal[i]);

            if (i == 0)
                System.out.println("Stop");
            else if (i == 1)
                System.out.println("Ready");
            else
                System.out.println("Go");

            System.out.println();
        }
    }
}
