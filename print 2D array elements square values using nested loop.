import java.util.*;
public class Main
{
	public static void main(String[] args) {
	Scanner hp=new Scanner(System.in);
	int n=hp.nextInt();
	int arr[][]=new int[n][n];
	for(int i=0;i<n;i++){
	    for(int j=0;j<n;j++){
	        arr[i][j]=hp.nextInt();
	    }
	}
	int a2[][]=new int[n][n];
	for(int i=0;i<n;i++){
	    for(int j=0;j<n;j++){
	        a2[i][j]=arr[i][j]*arr[i][j];
	    }
	}
	for(int i=0;i<a2.length;i++){
	    for(int j=0;j<a2.length;j++){
	        System.out.print(a2[i][j]+" ");
	    }
	    System.out.println("");
	}
	
}
}
