import java.util.*;
public class Main
{
	public static void main(String[] args) {
	Scanner hp=new Scanner(System.in);
	String str=hp.next();
	 int count=1;
	for(int i=0;i<str.length();i++){
	    if(i+1<str.length()&&str.charAt(i)==str.charAt(i+1)){
	        count++;
	    }else {
	        System.out.println(str.charAt(i)+""+count);
	        count=1;
	   }
	}
	 
	}
}
