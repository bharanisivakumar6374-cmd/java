import java.util.*;
public class Main
{
	public static void main(String[] args) {
	Scanner hp=new Scanner(System.in);
	String str=hp.next();
	int count=0,lccount=0;
	for(int i=0;i<str.length();i++){
	    char str2=str.charAt(i);
	    if(Character.isUpperCase(str2)){
	        count++;
	    }else{
	        lccount++;
	    }

	}
System.out.println("this isUpperCase:"+count);
System.out.println("this is lowercase:"+lccount);
	}
}
	
	
