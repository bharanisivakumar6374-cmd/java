import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		Scanner hp= new Scanner(System.in);
		int n=hp.nextInt();
	int max=0,second=0,total=0;
	int arr[]=new int[n];
	for(int i=0;i<n;i++){
	    arr[i]=hp.nextInt();
	}
	for(int i=0;i<n;i++){
	    total=total+arr[i];
	    if(arr[i]>max){
	        second=max;
	        max=arr[i];
	    }else if(arr[i]>second&&arr[i]!=max){
	        arr[i]=second;
	    }
	    
	}
	float average=total/n;
	System.out.println("this is max value:"+max);
	System.out.println("this is average:"+average);
	}
}
