import java.util.Scanner;
public class Pattern2 {
	public static void main(String[] args) {
	    Scanner hp = new Scanner(System.in);
	    int n =hp.nextInt();
	    for(int i=1;i<=n;i++){
	        int ascii=97;
	        for (int j=1;j<=i;j++ ) {
	            System.out.print((char)ascii+" ");
	            ascii++;
	        }
	        System.out.println();
	        
	    }
	
	}
}
