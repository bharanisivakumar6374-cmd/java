import java.util.Scanner;
public class Main{
    public static void main (String[] args) {
        Scanner hp= new Scanner(System.in);
        int n =hp.nextInt();
        int count=0,odd=0,odd_sum=0,even_sum=0, total=0;
      int arr[]=new int[n];
      for(int i=0;i<n;i++){
          arr[i]=hp.nextInt();
      }
      for (int i=0;i<n ;i++ ) {
          if(arr[i]%2==0){
              System.out.println(" even values");
          System.out.println(+arr[i]);
          even_sum+=arr[i];
          
          count++;
          
          
      }else{
          System.out.println(" odd values:");
          System.out.println(+arr[i]);
          odd_sum+=arr[i];
          odd++;
      }
      
      }
       total+=even_sum+odd_sum;
      System.out.println("this total all "+total);
      System.out.println("total count  even is:"+count);
      System.out.println("this odd count:"+odd);
    }
} 
