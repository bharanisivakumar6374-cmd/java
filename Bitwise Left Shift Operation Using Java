import java.util.*;
public class Main
{
	public static void main(String[] args) {
	Scanner hp= new Scanner(System.in);
	int n=hp.nextInt();
	int k=hp.nextInt();
	int shift=0,sum=0;
	for(int i=1;i<=k;i++){
	   shift = n*(int)Math.pow(2,i);
	   sum+=shift;
	   System.out.println("this the value of :"+shift);
	} 
	System.out.println("sum:"+sum);
	}
	
}
