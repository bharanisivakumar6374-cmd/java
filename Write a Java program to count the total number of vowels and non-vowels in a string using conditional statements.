import java.util.*;
public class Main
{
	public static void main(String[] args) {
	Scanner hp=new Scanner(System.in);
	String str=hp.next();
    str = str.toUpperCase();
	int count=0;
	for(int i=0;i<str.length();i++){
	    char str2=str.charAt(i);
	
	if(str2=='a'||str2=='e'||str2=='i'||str2=='o'||str2=='u'){
	    count++;
	}
    
	}
	int dup=str.length()-count;
	System.out.println("total count of vowels:"+count);
	System.out.println("non-vowels count:"+dup);
	}
	
}
